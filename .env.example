# Database
DATABASE_URL=sqlite:///recruit_smart.db

# Flask
SECRET_KEY=your-super-secret-key-change-this
FLASK_ENV=development
FLASK_APP=run.py

# Mail (Gmail SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# OAuth (Google) -- create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI to register: http://localhost:5000/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth (LinkedIn) -- create at https://www.linkedin.com/developers/apps
# Add the "Sign In with LinkedIn using OpenID Connect" product to the app.
# Authorized redirect URL to register: http://localhost:5000/auth/linkedin/callback
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# Admin
# Set your own strong password here before deploying -- do NOT leave this
# blank in production and do NOT reuse a weak/example value. If you leave
# ADMIN_PASSWORD unset, the app generates a random one and prints it once
# to the server log on first startup (see app/utils/seed_data.py).
ADMIN_EMAIL=admin@recruitsmart.ai
ADMIN_PASSWORD=set-your-own-strong-password-here

# File Upload
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=app/static/uploads

# Rate Limiting
RATELIMIT_STORAGE_URI=memory://

# GitHub Portfolio Verification (optional - raises API rate limit from 60/hr to 5000/hr)
GITHUB_TOKEN=
